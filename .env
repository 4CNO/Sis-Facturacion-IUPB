## FactuLogin v4.0 — Variables de Entorno (PostgreSQL + Prisma)
## NUNCA subas .env real a Git.
## Configura con: cp .env.example .env

NODE_ENV=development
PORT=3000

# ── BASE DE DATOS — PostgreSQL ───────────────────────────────────────
# Formato: postgresql://USUARIO:PASSWORD@HOST:5432/NOMBRE_DB?schema=public
#
# Opciones de proveedor gratuito:
#   - Supabase:      https://supabase.com  (gratuito, PostgreSQL gestionado)
#   - Neon:          https://neon.tech     (gratuito, serverless PostgreSQL)
#   - Railway:       https://railway.app   (PostgreSQL en la nube)
#   - Local Docker:  postgresql://postgres:password@localhost:5432/factulogin
#
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:5432/factulogin?schema=public
- Supabase:      https://supabase.com  

# ── JWT (REQUERIDO) ──────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERA_UN_SECRETO_SEGURO_DE_64_BYTES_AQUI

# ── CORS ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── SMTP (opcional) ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_clave_de_aplicacion
SMTP_FROM=FactuLogin <tu_correo@gmail.com>
