// prisma/schema.prisma
// FactuLogin v4.0 — PostgreSQL + Prisma ORM
// Migrado desde MongoDB + Mongoose (dos clusters) a una sola base de datos relacional.
//
// Ventajas de esta migración:
//   - Un único cluster PostgreSQL (más simple, menos costos)
//   - Relaciones FK con integridad referencial garantizada por el motor
//   - Prisma genera tipos TypeScript/JS automáticamente
//   - Migrations versionadas (git-friendly)
//   - Query engine nativo compilado en Rust (rendimiento superior a Mongoose)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USUARIOS ───────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(120)
  email         String   @unique @db.VarChar(255)
  password_hash String
  profile_image String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relaciones
  notifications Notification[]
  invoices      Invoice[]
  events        UserEvent[]
  orders        Order[]

  @@index([email])
  @@map("users")
}

model Notification {
  id         String   @id @default(cuid())
  user_id    String
  message    String   @db.VarChar(500)
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("notifications")
}

model Invoice {
  id          String   @id @default(cuid())
  user_id     String
  description String   @db.VarChar(300)
  total       Decimal  @db.Decimal(12, 2)
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("invoices")
}

model UserEvent {
  id         String   @id @default(cuid())
  user_id    String
  action     String   @db.VarChar(100)
  detail     String?  @db.VarChar(300)
  ip         String?  @db.VarChar(45)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_events")
}

// ─── NEGOCIO ─────────────────────────────────────────────────────────────────

model Client {
  id         String   @id @default(cuid())
  name       String   @db.VarChar(180)
  document   String   @unique @db.VarChar(30)
  phone      String   @db.VarChar(20)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  orders Order[]

  @@index([document])
  @@map("clients")
}

model Company {
  id         String   @id @default(cuid())
  name       String   @db.VarChar(180)
  nit        String   @unique @db.VarChar(30)
  phone      String   @db.VarChar(20)
  address    String   @db.VarChar(300)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  orders Order[]

  @@index([nit])
  @@map("companies")
}

model Product {
  id         String   @id @default(cuid())
  name       String   @db.VarChar(180)
  brand      String   @default("") @db.VarChar(100)
  price      Decimal  @db.Decimal(12, 2)
  stock      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  order_items OrderItem[]

  @@index([name])
  @@map("products")
}

model Order {
  id         String   @id @default(cuid())
  user_id    String?
  client_id  String
  company_id String
  total      Decimal  @db.Decimal(12, 2)
  created_at DateTime @default(now())

  user    User?       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  client  Client      @relation(fields: [client_id], references: [id])
  company Company     @relation(fields: [company_id], references: [id])
  items   OrderItem[]

  @@index([user_id])
  @@index([created_at(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  order_id     String
  product_id   String
  product_name String  @db.VarChar(180)
  quantity     Int
  price        Decimal @db.Decimal(12, 2)
  pct_desc     Decimal @default(0) @db.Decimal(5, 4)
  subtotal     Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@map("order_items")
}
